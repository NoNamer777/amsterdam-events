{
  "name": "amsterdam-events",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "playwright-install": "playwright install chromium --with-deps",
    "start": "ng serve",
    "build": "ng build",
    "test-ci": "ng test -c ci",
    "test": "ng test",
    "format": "prettier -w .",
    "format-check": "prettier -l .",
    "lint-ts": "ng lint"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@angular/cdk": "catalog:angular",
    "@angular/common": "catalog:angular",
    "@angular/compiler": "catalog:angular",
    "@angular/core": "catalog:angular",
    "@angular/forms": "catalog:angular",
    "@angular/platform-browser": "catalog:angular",
    "@angular/router": "catalog:angular",
    "bootstrap": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@angular-eslint/builder": "catalog:angular-eslint",
    "@angular/build": "catalog:angular-cli",
    "@angular/cli": "catalog:angular-cli",
    "@angular/compiler-cli": "catalog:angular",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:vitest",
    "@vitest/coverage-v8": "catalog:vitest",
    "@vitest/ui": "catalog:vitest",
    "angular-eslint": "catalog:angular-eslint",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-ban": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:vitest"
  }
}
